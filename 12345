// =====================================================================
// TIME HELPERS (GPS date+time -> Unix epoch milliseconds)
// =====================================================================
static int64_t daysFromCivil(int y, int m, int d) {
  y -= (m <= 2);
  const int era = (y >= 0 ? y : y - 399) / 400;
  const int yoe = y - era * 400;
  const int doy = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + d - 1;
  const int doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
  return (int64_t)era * 146097 + doe - 719468;
}

static int64_t gpsEpochMs() {
  int64_t days = daysFromCivil(gps.date.year(), gps.date.month(), gps.date.day());
  int64_t secs = days * 86400LL + gps.time.hour() * 3600LL +
                 gps.time.minute() * 60LL + gps.time.second();
  return secs * 1000LL + gps.time.centisecond() * 10LL;
}

// =====================================================================
// GPS: evaluate fix once per second and publish a snapshot
// =====================================================================
static void tickGps() {
  const uint32_t now = millis();

  uint32_t chars = gps.charsProcessed();
  if (chars != lastChars) { lastChars = chars; lastCharsMs = now; }
  const bool flowing = (chars > 0) && (now - lastCharsMs < NMEA_TIMEOUT_MS);

  const bool locValid   = gps.location.isValid();
  const uint32_t locAge = locValid ? gps.location.age() : 0xFFFFFFFFUL;
  const bool satsFresh  = gps.satellites.isValid() && gps.satellites.age() <= MAX_FIELD_AGE_MS;
  const bool hdopFresh  = gps.hdop.isValid() && gps.hdop.age() <= MAX_FIELD_AGE_MS;
  const bool timeFresh  = gps.date.isValid() && gps.time.isValid() &&
                          gps.time.age() <= MAX_FIELD_AGE_MS && gps.date.year() >= 2023;

  const int    sats = satsFresh ? (int)gps.satellites.value() : 0;
  const double hdop = hdopFresh ? gps.hdop.hdop() : 99.99;

  const char* reason = nullptr;
  if (!flowing)                                  reason = "no NMEA data from NEO-6M";
  else if (!locValid)                            reason = "no position yet (searching satellites)";
  else if (locAge > MAX_FIX_AGE_MS)              reason = "position is stale (fix lost)";
  else if (!satsFresh || sats < MIN_SATELLITES)  reason = "too few satellites";
  else if (!hdopFresh)                           reason = "HDOP unavailable";
  else if (hdop > MAX_HDOP)                      reason = "HDOP too high (poor geometry / weak signal)";
  else if (!timeFresh)                           reason = "GPS date/time not valid";

  bool fix = (reason == nullptr);

  double lat = 0, lng = 0;
  if (fix) {
    lat = gps.location.lat();
    lng = gps.location.lng();
    if (isnan(lat) || isnan(lng) || lat < -90 || lat > 90 || lng < -180 || lng > 180 ||
        (fabs(lat) < 0.0001 && fabs(lng) < 0.0001)) {
      fix = false;
      reason = "coordinates out of range / 0,0";
    }
  }

  bool jumped = false;
  if (fix) {
    if (haveLast) {
      if (fabs(lat - lastLat) < 1e-7 && fabs(lng - lastLng) < 1e-7) identicalSeconds++;
      else identicalSeconds = 0;
      double d = TinyGPSPlus::distanceBetween(lastLat, lastLng, lat, lng);
      jumped = d > JUMP_WARN_METERS;
    }
    lastLat = lat; lastLng = lng; haveLast = true;
  } else {
    haveLast = false;
    identicalSeconds = 0;
  }

  GpsSnapshot s;
  s.ready       = true;
  s.fix         = fix;
  s.nmeaFlowing = flowing;
  s.sats        = sats;
  s.hdopValid   = hdopFresh;
  s.hdop        = hdop;
  s.seq         = ++seqCounter;
  if (fix) {
    double spd = gps.speed.isValid() ? gps.speed.kmph() : 0.0;
    if (spd < SPEED_DEADBAND_KMH) spd = 0.0;
    s.lat        = lat;
    s.lng        = lng;
    s.alt        = gps.altitude.isValid() ? gps.altitude.meters() : 0.0;
    s.speedKmh   = spd;
    s.accuracy   = hdop * ACCURACY_PER_HDOP_M;
    s.deviceTsMs = gpsEpochMs();
    s.status     = "GPS_ONLINE";
  } else {
    s.status     = flowing ? "GPS_LOST" : "GPS_NO_DATA";
  }

  xSemaphoreTake(g_snapMutex, portMAX_DELAY);
  g_snap = s;
  xSemaphoreGive(g_snapMutex);

#if USE_LEDS
  digitalWrite(LED_GPS_FIX, fix ? HIGH : LOW);
  digitalWrite(LED_ERROR, (g_wifiOk && g_fbOk) ? LOW : HIGH);
#endif

  // ---------------- Serial Monitor output (every second) ----------------
  Serial.println();
  if (fix) {
    Serial.println("GPS FIX");
    Serial.printf("Latitude: %.6f\n", s.lat);
    Serial.printf("Longitude: %.6f\n", s.lng);
    Serial.printf("Altitude: %.2f m\n", s.alt);
    Serial.printf("Speed: %.2f km/h\n", s.speedKmh);
    Serial.printf("Satellites: %d\n", s.sats);
    Serial.printf("HDOP: %.2f  (est. accuracy ~%.1f m)\n", s.hdop, s.accuracy);
    Serial.printf("GPS UTC: %04d-%02d-%02d %02d:%02d:%02d\n",
                  gps.date.year(), gps.date.month(), gps.date.day(),
                  gps.time.hour(), gps.time.minute(), gps.time.second());
    Serial.println("GPS Status: ONLINE");
    if (jumped)
      Serial.printf("WARNING: position jumped > %.0f m in 1 s (multipath / weak signal?)\n", JUMP_WARN_METERS);
    if (identicalSeconds >= FROZEN_WARN_SECONDS)
      Serial.printf("WARNING: coordinates identical for %lu s (stationary receiver or frozen data)\n",
                    (unsigned long)identicalSeconds);
  } else {
    Serial.println("GPS STATUS: LOST");
    Serial.printf("Satellites: %d\n", sats);
    Serial.printf("Reason: %s\n", reason ? reason : "unknown");
    if (!flowing) Serial.println("Check wiring (NEO-6M TX -> GPIO16), power and baud rate 9600.");
    else          Serial.println("Waiting for valid GPS fix...");
  }
  Serial.printf("[Net] WiFi: %s rssi=%d | Firebase: %s (ok=%lu fail=%lu, last HTTP=%d)\n",
                g_wifiOk ? "OK" : "DOWN",
                g_wifiOk ? WiFi.RSSI() : 0,
                g_fbOk ? "OK" : "DOWN",
                (unsigned long)g_fbOkCount, (unsigned long)g_fbFailCount, g_lastHttpCode);
#if REQUIRE_PAIRING
  Serial.printf("[Pair] %s\n", g_paired ? "PAIRED - uploading GPS" : "WAITING FOR APP PASSKEY");
#endif
  Serial.printf("[NMEA] chars=%lu sentencesWithFix=%lu checksumFailed=%lu\n",
                (unsigned long)gps.charsProcessed(),
                (unsigned long)gps.sentencesWithFix(),
                (unsigned long)gps.failedChecksum());
}

// =====================================================================
// FIREBASE BODY
// (same fields as before; ADDED: "sig" = HMAC of the data, and an
//  AWAITING_PAIRING heartbeat body while the app has not paired yet)
// =====================================================================
static void buildBody(const GpsSnapshot& s, char* out, size_t n) {
  char hdopStr[16];
  if (s.hdopValid) snprintf(hdopStr, sizeof(hdopStr), "%.2f", s.hdop);
  else             strcpy(hdopStr, "null");

#if REQUIRE_PAIRING
  const bool paired = g_paired;
#else
  const bool paired = true;
#endif

  char canon[160];
  char sig[65];

  if (!paired) {
    // Not paired: heartbeat only. No coordinates are published (old ones are wiped).
    snprintf(canon, sizeof(canon), "v1|%lu|%s|%d",
             (unsigned long)s.seq, "AWAITING_PAIRING", s.sats);
    hmacSha256Hex(DEVICE_PASSKEY, canon, sig);
    snprintf(out, n,
      "{\"latitude\":null,\"longitude\":null,\"deviceTimestamp\":null,"
      "\"speed\":0,\"accuracy\":null,\"satellites\":%d,\"hdop\":%s,"
      "\"gpsFix\":false,\"status\":\"AWAITING_PAIRING\",\"seq\":%lu,"
      "\"sig\":\"%s\",\"updatedAt\":{\".sv\":\"timestamp\"}}",
      s.sats, hdopStr, (unsigned long)s.seq, sig);
    return;
  }

  if (s.fix) {
    const long long latE6 = llround(s.lat * 1e6);
    const long long lngE6 = llround(s.lng * 1e6);
    char latStr[24], lngStr[24];
    fmtE6(latE6, latStr, sizeof(latStr));
    fmtE6(lngE6, lngStr, sizeof(lngStr));

    snprintf(canon, sizeof(canon), "v1|%lu|%s|%lld|%lld|%lld|%d",
             (unsigned long)s.seq, "GPS_ONLINE", latE6, lngE6,
             (long long)s.deviceTsMs, s.sats);
    hmacSha256Hex(DEVICE_PASSKEY, canon, sig);

    snprintf(out, n,
      "{\"latitude\":%s,\"longitude\":%s,\"altitude\":%.1f,\"speed\":%.2f,"
      "\"accuracy\":%.1f,\"satellites\":%d,\"hdop\":%s,"
      "\"gpsFix\":true,\"status\":\"GPS_ONLINE\","
      "\"deviceTimestamp\":%lld,\"seq\":%lu,\"sig\":\"%s\","
      "\"updatedAt\":{\".sv\":\"timestamp\"}}",
      latStr, lngStr, s.alt, s.speedKmh, s.accuracy, s.sats, hdopStr,
      (long long)s.deviceTsMs, (unsigned long)s.seq, sig);
  } else {
    snprintf(canon, sizeof(canon), "v1|%lu|%s|%d",
             (unsigned long)s.seq, s.status, s.sats);
    hmacSha256Hex(DEVICE_PASSKEY, canon, sig);

    // No valid fix: last known latitude/longitude/deviceTimestamp stay untouched
    // (update = PATCH), but the state is clearly flagged. The app never shows them as live.
    snprintf(out, n,
      "{\"speed\":0,\"accuracy\":null,\"satellites\":%d,\"hdop\":%s,"
      "\"gpsFix\":false,\"status\":\"%s\",\"seq\":%lu,\"sig\":\"%s\","
      "\"updatedAt\":{\".sv\":\"timestamp\"}}",
      s.sats, hdopStr, s.status, (unsigned long)s.seq, sig);
  }
}

// =====================================================================
// PAIRING STEP (ADDED) - runs inside the upload task while NOT paired.
// 1) publish a random challenge to /auth/<device>/challenge
// 2) read the app's answer at /auth/<device>/response (nonce + proof)
// 3) proof must equal HMAC(passkey, "APP|"+nonce)  -> paired
// =====================================================================
static void pairingStep() {
  static char     nonce[33]   = "";
  static uint32_t challengeAt = 0;
  static uint32_t lastPoll    = 0;
  static uint32_t holdUntil   = 0;
  const uint32_t now = millis();

  if ((int32_t)(now - holdUntil) < 0) return;

  // ---- (1) publish a new challenge when needed ----
  if (nonce[0] == '\0' || now - challengeAt >= PAIR_CHALLENGE_TTL_MS) {
    makeNonce(nonce);
    Firebase.RTDB.deleteNode(&fbdo, FB_AUTH_PATH "/response");

    char b[160];
    snprintf(b, sizeof(b),
             "{\"challenge\":\"%s\",\"paired\":false,\"challengeAt\":{\".sv\":\"timestamp\"}}",
             nonce);
    FirebaseJson j;
    j.setJsonData(b);
    if (Firebase.RTDB.updateNodeSilent(&fbdo, FB_AUTH_PATH, &j)) {
      challengeAt = now;
      lastPoll    = now;
      Serial.println("[Pair] challenge published - waiting for the app...");
    } else {
      nonce[0]  = '\0';
      holdUntil = now + 5000;
      Serial.printf("[Pair] could not publish challenge: %s (check RULES for /auth)\n",
                    fbdo.errorReason().c_str());
    }
    return;
  }

  // ---- (2) look for the app's answer ----
  if (now - lastPoll < PAIR_POLL_MS) return;
  lastPoll = now;

  if (!Firebase.RTDB.getString(&fbdo, FB_AUTH_PATH "/response/nonce")) return;
  if (fbdo.dataType() != "string") return;
  String rn = fbdo.stringData();
  if (rn != String(nonce)) return;                       // old / unrelated answer

  if (!Firebase.RTDB.getString(&fbdo, FB_AUTH_PATH "/response/proof")) return;
  if (fbdo.dataType() != "string") return;
  String proof = fbdo.stringData();

  // ---- (3) verify ----
  char msg[48], expected[65];
  snprintf(msg, sizeof(msg), "APP|%s", nonce);
  hmacSha256Hex(DEVICE_PASSKEY, msg, expected);

  if (safeEqual(expected, proof.c_str())) {
    g_paired = true;
    g_prefs.putString("pairId", String(g_pairId));       // survive reboot
    FirebaseJson ok;
    ok.setJsonData("{\"paired\":true,\"pairedAt\":{\".sv\":\"timestamp\"},"
                   "\"challenge\":null,\"challengeAt\":null,\"response\":null}");
    Firebase.RTDB.updateNodeSilent(&fbdo, FB_AUTH_PATH, &ok);
    nonce[0] = '\0';
    Serial.println("[Pair] *** PASSKEY ACCEPTED - app paired. GPS upload enabled. ***");
  } else {
    Serial.println("[Pair] WRONG passkey from app - rejected. Check both passkeys are identical.");
    Firebase.RTDB.deleteNode(&fbdo, FB_AUTH_PATH "/response");
    nonce[0]  = '\0';                                    // force a brand-new challenge
    holdUntil = now + 8000;                              // slow down guessing
  }
}

// =====================================================================
// UPLOAD TASK (core 0). Never blocks GPS reading on core 1.
// =====================================================================
static void firebaseTask(void* param) {
  bool     fbStarted       = false;
  uint32_t lastSeq         = 0;
  uint32_t lastWifiRetry   = 0;
  uint32_t lastNotReadyMsg = 0;
  char     body[640];                 // (was 420) larger because of the "sig" field
  FirebaseJson json;

  for (;;) {
    const uint32_t now = millis();

    // ---- WiFi watchdog / auto-reconnect ----
    if (WiFi.status() != WL_CONNECTED) {
      g_wifiOk = false;
      g_fbOk   = false;
      if (now - lastWifiRetry >= WIFI_RETRY_MS) {
        lastWifiRetry = now;
        Serial.println("[WiFi] not connected - reconnecting...");
        WiFi.disconnect();
        WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
      }
      vTaskDelay(pdMS_TO_TICKS(250));
      continue;
    }
    g_wifiOk = true;

    // ---- One-time Firebase init once WiFi is up ----
    if (!fbStarted) {
      configTime(0, 0, "pool.ntp.org", "time.nist.gov");   // TLS/token needs valid time
      config.api_key               = API_KEY;
      config.database_url          = DATABASE_URL;
      auth.user.email              = USER_EMAIL;
      auth.user.password           = USER_PASSWORD;
      config.token_status_callback = tokenStatusCallback;   // prints login/token status
      fbdo.setBSSLBufferSize(4096, 1024);
      Firebase.begin(&config, &auth);
      fbStarted = true;
      Serial.println("[Firebase] initialised, logging in...");
    }

    if (!Firebase.ready()) {
      g_fbOk = false;
      if (now - lastNotReadyMsg > 5000) {
        lastNotReadyMsg = now;
        Serial.println("[Firebase] not ready yet (logging in / token refresh)...");
      }
      vTaskDelay(pdMS_TO_TICKS(200));
      continue;
    }

#if REQUIRE_PAIRING
    // ---- ADDED: passkey pairing while not yet paired ----
    if (!g_paired) pairingStep();
#endif

    // ---- Take the newest snapshot (skip if already uploaded) ----
    GpsSnapshot s;
    xSemaphoreTake(g_snapMutex, portMAX_DELAY);
    s = g_snap;
    xSemaphoreGive(g_snapMutex);

    if (!s.ready || s.seq == lastSeq) {
      vTaskDelay(pdMS_TO_TICKS(20));
      continue;
    }
    lastSeq = s.seq;   // one attempt per snapshot; on failure the NEXT (fresh) one is sent

    buildBody(s, body, sizeof(body));
    json.clear();
    json.setJsonData(body);

#if USE_LEDS
    digitalWrite(LED_SENDING, HIGH);
#endif

    const bool ok = Firebase.RTDB.updateNodeSilent(&fbdo, FB_PATH, &json);
    g_lastHttpCode = fbdo.httpCode();

    if (ok) {
      g_fbOk = true;
      g_fbOkCount++;
    } else {
      g_fbOk = false;
      g_fbFailCount++;
      Serial.printf("[Firebase] upload FAILED: %s (HTTP %d)\n",
                    fbdo.errorReason().c_str(), fbdo.httpCode());
      if (fbdo.httpCode() == 401 || fbdo.httpCode() == 403)
        Serial.println("[Firebase] Permission denied - check Realtime Database RULES.");
    }

#if USE_LEDS
    digitalWrite(LED_SENDING, LOW);
#endif

    vTaskDelay(pdMS_TO_TICKS(20));
  }
}

// =====================================================================
// SETUP / LOOP
// =====================================================================
void setup() {
  Serial.begin(115200);
  delay(500);
  Serial.println("\n=== MotoGuard ESP32: NEO-6M -> Firebase ===");

#if USE_LEDS
  pinMode(LED_GPS_FIX, OUTPUT);
  pinMode(LED_SENDING, OUTPUT);
  pinMode(LED_ERROR, OUTPUT);
  digitalWrite(LED_GPS_FIX, LOW);
  digitalWrite(LED_SENDING, LOW);
  digitalWrite(LED_ERROR, HIGH);
#endif

  g_snapMutex = xSemaphoreCreateMutex();

  pairingInit();                      // ADDED: load saved passkey pairing

  gpsSerial.setRxBufferSize(1024);   // must be called BEFORE begin()
  gpsSerial.begin(GPS_BAUD, SERIAL_8N1, GPS_RX_PIN, GPS_TX_PIN);
  Serial.printf("GPS UART2 started: RX=GPIO%d TX=GPIO%d @ %lu baud\n",
                GPS_RX_PIN, GPS_TX_PIN, (unsigned long)GPS_BAUD);

  // Non-blocking WiFi start: GPS keeps working even if WiFi never connects
  WiFi.mode(WIFI_STA);
  WiFi.persistent(false);
  WiFi.setAutoReconnect(true);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  Serial.printf("WiFi connecting to \"%s\" in background...\n", WIFI_SSID);

  xTaskCreatePinnedToCore(firebaseTask, "firebaseTask", 20480, nullptr, 1, nullptr, 0);

  lastTickMs = millis();
}

void loop() {
  // 1) Drain everything the GPS sent. Never blocks.
  while (gpsSerial.available() > 0) {
    char c = (char)gpsSerial.read();
#if RAW_NMEA_DEBUG
    Serial.write(c);
#endif
    gps.encode(c);
  }

  // 2) Once per second: validate + publish snapshot + print
  const uint32_t now = millis();
  if (now - lastTickMs >= 1000) {
    lastTickMs = now;
    tickGps();
  }

  delay(2);
}
