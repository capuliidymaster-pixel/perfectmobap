// HMAC-SHA256(key, msg) -> 64 lowercase hex chars (+ '\0'). outHex must hold 65 bytes.
static void hmacSha256Hex(const char* key, const char* msg, char* outHex) {
  uint8_t out[32];
  const mbedtls_md_info_t* info = mbedtls_md_info_from_type(MBEDTLS_MD_SHA256);
  mbedtls_md_hmac(info,
                  (const unsigned char*)key, strlen(key),
                  (const unsigned char*)msg, strlen(msg),
                  out);
  for (int i = 0; i < 32; i++) sprintf(outHex + i * 2, "%02x", out[i]);
  outHex[64] = '\0';
}

// Constant-time string compare (no early exit).
static bool safeEqual(const char* a, const char* b) {
  const size_t la = strlen(a), lb = strlen(b);
  if (la != lb) return false;
  uint8_t d = 0;
  for (size_t i = 0; i < la; i++) d |= (uint8_t)(a[i] ^ b[i]);
  return d == 0;
}

// 32 hex chars from the ESP32 hardware RNG. out must hold 33 bytes.
static void makeNonce(char* out) {
  for (int i = 0; i < 4; i++) sprintf(out + i * 8, "%08x", (unsigned)esp_random());
  out[32] = '\0';
}

// Signed decimal degrees from micro-degrees, e.g. 14599500 -> "14.599500".
// Printing from the integer guarantees the app computes the exact same integer.
static void fmtE6(long long v, char* out, size_t n) {
  const bool neg = v < 0;
  const long long a = neg ? -v : v;
  snprintf(out, n, "%s%lld.%06lld", neg ? "-" : "", a / 1000000LL, a % 1000000LL);
}

